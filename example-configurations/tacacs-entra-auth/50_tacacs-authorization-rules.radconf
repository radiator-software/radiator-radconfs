aaa {
@pipeline "TACACSPLUS_RULES" {

    # Copy request args to vars for indexed access in conditions
    vars.args = tacacsplus.request.args;

    # Map user's groups to TACACS+ authorization rules. Only the first rule
    # whose group the user is a member of is evaluated, and the request is
    # rejected if its conditions do not match.
    map user.group {

    # Group catch-all: reject if no group matches
    #############################################
        any => {
            reject "no rule match";
        }
    }

} # pipeline
} # aaa
