# 30_backends-jsonfile.radconf
#
# Backend for storing users public Yubikey UID for verifying user is using their own Yubikey
#

backends {
    jsonfile "JSONFILE_USERS_YUBIKEY_UID" {
        # JSON file to use
        filename "<root>/db/users-internal/users-yubikey-uid.json5";
        query "FIND_UID" {
          mapping {
            user.username = doc | jsonpath("$.users[?(@.username == '%{aaa.identity}')].username");
            vars.yubikey-uid = doc | jsonpath("$.users[?(@.username == '%{aaa.identity}')].yubikey_uid");
          }
        }
    }
}
