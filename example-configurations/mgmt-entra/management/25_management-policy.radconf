# management/25_management-policy.radconf


aaa {
    policy "MANAGEMENT_POLICY" {
        conditions all {
            aaa.protocol == protocol.MANAGEMENT;
        }

        handler "AUTHENTICATION" {
            @execute {
                http_management_authentication {
                    @resolve {
                        # Populate variables only when login or authorization refresh needs them.
                        invoke "SET_TENANT_INFORMATION";

                        if all {
                            # Entra users log in with a UPN so aaa.identity.realm is set.
                            # Local users (e.g. "admin") have no realm; any identity with a realm is looked up in Entra.
                            aaa.identity.realm != none;
                        } then {
                            # ---------- Entra realm ----------
                            # App-only Graph lookups resolve authorization during login and refresh.
                            until reject {
                                backend {
                                    name "MS_CLIENT_CREDENTIALS";
                                    query "AUTH_USERS";
                                }
                                backend {
                                    name "MS_CLIENT_CREDENTIALS";
                                    query "GET_GROUPS";
                                }
                            } when reject {
                                # Treat throttling and outages as refresh failures so sessions
                                # pause retries; ordinary account denials remain rejections.
                                if any {
                                    vars.entra_lookup_status == 429;
                                    vars.entra_lookup_status >= 500;
                                } then {
                                    error "Entra identity lookup unavailable";
                                } else {
                                    reject;
                                }
                            }

                            map user.group {
                                "Staff" => {
                                    user.radiatordb_role = "admin";
                                    user.privilege = "all";
                                }
                                "Ops" => {
                                    user.radiatordb_role = "operations";
                                    user.privilege = "all";
                                }
                                any => {
                                    user.privilege = "monitor";
                                }
                            }

                        } else {
                            # ---------- Local failsafe realm ----------
                            # Load local authorization for login or a stale session refresh.
                            backend {
                                name "MANAGEMENT_USERS";
                                query "FIND_USER";
                            }
                        }
                    }

                    @verify {
                        if all {
                            aaa.identity.realm != none;
                        } then {
                            until end {
                                try backend {
                                    name "MS_RESOURCE_OWNER_PASSWORD_CREDENTIALS";
                                    query "VERIFY_LOGIN";
                                }
                            } when accept {
                                # Password OK -> trigger the MFA push and wait for the result.
                                backend {
                                    name "ENTRA_MFA";
                                    query "MFA_CHALLENGE";
                                }
                                map vars.challenge_result_value {
                                    "Success" => {
                                        accept;
                                    }
                                    any => {
                                        reason "%{vars.challenge_result_message}";
                                        reject;
                                    }
                                }
                            } else {
                                reject "Authentication failed";
                            }
                        } else {
                            http_basic_auth;
                        }
                    }
                }
            }
        }
    }
}
