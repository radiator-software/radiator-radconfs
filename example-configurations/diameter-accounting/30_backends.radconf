backends {
    radius "ACCOUNTING_COLLECTOR" {
        server "LOCAL" {
            secret "mysecret";
            timeout 2s;
            retries 0;
            connect { protocol udp; host "127.0.0.1"; port 18183; }
        }
        query "NASREQ" { diameter_bridge "nasreq_accounting"; }
        query "R4" { diameter_bridge "r4_base_accounting"; }
    }
    diameter "R4_COLLECTOR" {
        server "ACCOUNTING";
        local_node "LOCAL";
        peer_group "R4_COLLECTOR";
        query "NASREQ" {
            profile "nasreq_accounting";
            destination_realm "example";
            accounting_failure_policy "retry";
        }
        query "R4" {
            profile "r4_base_accounting";
            destination_realm "example";
            accounting_failure_policy "retry";
        }
    }
}
