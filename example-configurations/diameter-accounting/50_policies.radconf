aaa {
    policy "ACCOUNTING_INGRESS" {
        conditions all { radius.request.code == radius.ACCOUNTING_REQUEST; }
        handler "TO_R4_NASREQ" {
            conditions all { radius.request.attr.NAS-Identifier == "to_r4_nasreq"; }
            @execute { backend { name "R4_COLLECTOR"; query "NASREQ"; timeout 3s; } }
            @final_execute { invoke "LOG_RADIUS_ACCOUNTING"; }
        }
        handler "TO_R4_BASE" {
            conditions all { radius.request.attr.NAS-Identifier == "to_r4_base"; }
            @execute { backend { name "R4_COLLECTOR"; query "R4"; timeout 3s; } }
            @final_execute { invoke "LOG_RADIUS_ACCOUNTING"; }
        }
        handler "LOCAL" {
            conditions all { radius.request.code == radius.ACCOUNTING_REQUEST; }
            @execute { accept; }
            @final_execute { invoke "LOG_RADIUS_ACCOUNTING"; }
        }
    }
    policy "ACCOUNTING_COLLECTOR" {
        handler "ACCOUNTING" {
            conditions all { radius.request.code == radius.ACCOUNTING_REQUEST; }
            @execute { accept; }
            @final_execute { invoke "LOG_RADIUS_ACCOUNTING"; }
        }
    }
    policy "DIAMETER_ACCOUNTING" {
        conditions all { diameter.command_code == diameter.COMMAND_ACCOUNTING; }
        handler "NASREQ" {
            conditions all { diameter.application_id == diameter.APPLICATION_NASREQ; }
            @execute {
                invoke "CAPTURE_DIAMETER_ACCOUNTING";
                backend { name "ACCOUNTING_COLLECTOR"; query "NASREQ"; }
            }
            @final_execute { invoke "LOG_DIAMETER_ACCOUNTING"; }
        }
        handler "R4" {
            conditions all { diameter.application_id == diameter.APPLICATION_BASE_ACCOUNTING; }
            @execute {
                invoke "CAPTURE_DIAMETER_ACCOUNTING";
                backend { name "ACCOUNTING_COLLECTOR"; query "R4"; }
            }
            @final_execute { invoke "LOG_DIAMETER_ACCOUNTING"; }
        }
    }
}
