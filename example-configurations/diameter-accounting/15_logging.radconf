logging {
    aaa {
        logger "DIAMETER_ACCOUNTING" {
            file { filename "/var/log/radiator/diameter-accounting.log"; }
        }
        logger "RADIUS_ACCOUNTING" {
            file { filename "/var/log/radiator/radius-accounting.log"; }
        }
    }
}
aaa {
    # Capture request AVPs before the backend consumes Diameter request ownership.
    @pipeline "CAPTURE_DIAMETER_ACCOUNTING" {
        vars.accounting_session_id = "%{diameter.request.Session-Id}";
        vars.accounting_record_type = "%{diameter.request.Accounting-Record-Type}";
        vars.accounting_record_number = "%{diameter.request.Accounting-Record-Number}";
        vars.accounting_acct_session_id_hex = diameter.request.Acct-Session-Id | hex;
        vars.accounting_nas_identifier = "%{diameter.request.NAS-Identifier}";
        vars.accounting_username = "%{diameter.request.User-Name}";
        vars.accounting_input_octets = "%{diameter.request.Accounting-Input-Octets}";
        vars.accounting_output_octets = "%{diameter.request.Accounting-Output-Octets}";
        vars.accounting_session_time = "%{diameter.request.Acct-Session-Time}";
        vars.accounting_class_hex = diameter.request.Class | hex;
    }
    @pipeline "LOG_DIAMETER_ACCOUNTING" {
        log "DIAMETER_ACCOUNTING" {
            json {
                "timestamp" datetime.timestamp;
                "peer" diameter.peer_identity;
                "application_id" diameter.application_id;
                "session_id" "%{vars.accounting_session_id}";
                "record_type" "%{vars.accounting_record_type}";
                "record_number" "%{vars.accounting_record_number}";
                "acct_session_id_hex" "%{vars.accounting_acct_session_id_hex}";
                "nas_identifier" "%{vars.accounting_nas_identifier}";
                "username" "%{vars.accounting_username}";
                "input_octets" "%{vars.accounting_input_octets}";
                "output_octets" "%{vars.accounting_output_octets}";
                "session_time" "%{vars.accounting_session_time}";
                "class_hex" vars.accounting_class_hex;
                "result" "%{aaa.result}";
                "errors" "%{aaa.errors}";
            }
        }
    }
    @pipeline "LOG_RADIUS_ACCOUNTING" {
        log "RADIUS_ACCOUNTING" {
            json {
                "timestamp" datetime.timestamp;
                "policy" aaa.policy;
                "nas_identifier" radius.request.attr.NAS-Identifier;
                "acct_session_id" radius.request.attr.Acct-Session-Id;
                "status" "%{radius.request.attr.Acct-Status-Type}";
                "username" radius.request.attr.User-Name;
                "input_octets" "%{radius.request.attr.Acct-Input-Octets}";
                "input_gigawords" "%{radius.request.attr.Acct-Input-Gigawords}";
                "output_octets" "%{radius.request.attr.Acct-Output-Octets}";
                "output_gigawords" "%{radius.request.attr.Acct-Output-Gigawords}";
                "session_time" "%{radius.request.attr.Acct-Session-Time}";
                "class_hex" radius.request.attr.Class | hex;
                "result" "%{aaa.result}";
                "errors" "%{aaa.errors}";
            }
        }
    }
}
