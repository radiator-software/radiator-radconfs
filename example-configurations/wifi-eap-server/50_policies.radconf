# 50_policies.radconf
#
# Radiator policy configuration
#

aaa {

    # first matching policy is selected so for all accounting
    # to be processed within its own policy, it should
    # be the first one and match all accounting requests
    policy "ACCOUNTING" {

        conditions all {
            # match all accounting requests
            radius.request.code == radius.ACCOUNTING_REQUEST;
        }

        handler "ACCOUNTING" {
            conditions all {
                # match only RADIUS accounting requests
                radius.request.code == radius.ACCOUNTING_REQUEST;
            }

            @execute {
                # accept all accounting
                accept;
            }

            # log all accounting
            @final_execute {
                invoke "LOG_ACCOUNTING";
            }
        }
    }


    # policy for RADIUS PAP authentication
    policy "PAP" {
        conditions all {
            radius.request.method == radius.METHOD_PAP;
        }

        # handler for RADIUS authentication
        handler "AUTHENTICATION-PAP" {
            conditions all {
                # match only RADIUS PAP authentication requests
                radius.request.code == radius.ACCESS_REQUEST;
                radius.request.method == radius.METHOD_PAP;
            }

            @execute {
                backend {
                    name "JSONFILE_USERS_INTERNAL";
                    query "FIND_USER";
                }

                # try to authenticate user with PAP
                must pap;
            }

            @final_execute {
                invoke "LOG_AUTHENTICATION";
            }

        }


        # DEFAULT handler rejects all authentication, accepts accounting
        handler "DEFAULT-PAP" {
            conditions any {
                radius.request.code == any;
            }
            @execute {
                if all {
                    radius.request.code == radius.ACCOUNTING_REQUEST;
                } then {
                    accept;
                } else {
                    reason "DEFAULT: No other matching authentication handler found.";
                    reject;
                }
            }
            @final_execute {
                invoke "LOG_ACCOUNTING";
                invoke "LOG_AUTHENTICATION";
            }
        }
    }


    # policy for RADIUS EAP authentication and clients
    policy "EAP" {
        conditions any {
            radius.request.method == radius.METHOD_EAP;
            radius.client == "RADSEC_CLIENTS_INTERNET";
        }

        # handler for RADIUS authentication
        handler "AUTHENTICATION-EAP" {
            conditions all {
                # match only RADIUS authentication requests
                radius.request.code == radius.ACCESS_REQUEST;
                #aaa.identity.realm == "example.com";
            }

            @execute {
                must eap {

                    # EAP-TLS client authentication
                    eap_tls {
                        tls {

                            # EAP server private key
                            certificate_key "EAP_SERVER_KEY";

                            # EAP server certificate chain
                            certificate "EAP_SERVER_CERT";

                            # CA certificate for verifying EAP-TLS
                            # client certificates
                            client_ca_certificate "EAP_SERVER_CLIENT_CA";

                            # Use CA certificate directory certificates for
                            # client certificate validation
                            #client_ca_certificate "EAP_SERVER_CLIENT_CA_DIRECTORY";

                            # Certificate revocation list (CRL) for rejecting
                            # revoked client certificates. The CRL must be
                            # issued by the CA that signed the client certificates.
                            crl "EAP_SERVER_CLIENT_CRL";

                        } # end of tls block

                        @post_authentication {

                            # if there is a SubjectAltName email
                            if any {
                                cert.subject_alt.email != none;
                            }
                            # copy the email to vars for logging
                            then {
                                vars.certemail = cert.subject_alt.email;
                            }

                            # log authentication requests
                            invoke "LOG_AUTHENTICATION";

                        } # post_authentication
                    } # end of eap_tls block

                    # EAP-TTLS authentication
                    eap_ttls {
                        tls {

                            # EAP server private key
                            certificate_key "EAP_SERVER_KEY";

                            # EAP server certificate chain file
                            certificate "EAP_SERVER_CERT";

                            # EAP-TTLS doesn't typically require a client
                            # certificate. If needed, see the eap_tls block
                            # above for configuring client certificate
                            # verification and the CRL.
                            require_client_certificate false;

                        } # end of tls block

                        # Supporting both non-EAP (PAP, CHAP, MSCHAPV2)
                        # and EAP methods (EAP-MSCHAPv2) for EAP-TTLS
                        # requires this kind of configuration for inner
                        # authentication to work.
                        #
                        # If only non-EAP or EAP within EAP-TTLS can be selected,
                        # the configuration can be simplified.
                        @authentication {
                            # Determine whether the tunneled payload contains a
                            # non-EAP response before looking up its user. An
                            # EAP-Response/Identity also supplies a username,
                            # so a user lookup cannot distinguish these paths.
                            until accept {
                                pap response;
                                chap response;
                                mschap response;
                                mschapv2 response;
                            } when accept {
                                backend { name "JSONFILE_USERS_INTERNAL"; query "FIND_USER"; }

                                # Authenticate the extracted non-EAP response.
                                until accept reject {
                                    pap;
                                    chap;
                                    mschap;
                                    mschapv2;
                                }
                            } else {
                                eap {
                                    eap_mschapv2 {
                                        max_password_retries 0;

                                        @authentication {
                                            backend { name "JSONFILE_USERS_INTERNAL"; query "FIND_USER"; }
                                            mschapv2;
                                        }
                                    }
                                }
                            }
                        }

                        #@post_authentication {
                        #
                        #    # if there is a SubjectAltName email
                        #    if any {
                        #        cert.subject_alt.email != none;
                        #    }
                        #    # copy the email to vars for logging
                        #    then {
                        #        vars.certemail = cert.subject_alt.email;
                        #    }
                        #} # post_authentication

                        # log inner authentication requests
                        @post_authentication {
                            invoke "LOG_AUTHENTICATION";
                        }

                    }

                    # PEAP authentication
                    eap_peap {
                        tls {

                            # EAP server private key
                            certificate_key "EAP_SERVER_KEY";

                            # EAP server certificate chain file
                            certificate "EAP_SERVER_CERT";

                            # EAP-PEAP doesn't typically require a client
                            # certificate. If needed, see the eap_tls block
                            # above for configuring client certificate
                            # verification and the CRL.
                            require_client_certificate false;

                        } # end of tls block

                        @authentication {
                            eap {
                                # authenticate the EAP-PEAP inner requests with EAP-MSCHAPv2
                                eap_mschapv2 {
                                    max_password_retries 0;

                                    @authentication {
                                        backend {
                                            name "JSONFILE_USERS_INTERNAL";
                                            query "FIND_USER";
                                        }
                                        mschapv2;
                                    }
                                    # log inner authentication
                                    @post_authentication {
                                        invoke "LOG_AUTHENTICATION";
                                    }
                                }
                            }
                        }

                        #@post_authentication {
                        #
                        #    # if there is a SubjectAltName email
                        #    if any {
                        #        cert.subject_alt.email != none;
                        #    }
                        #    # copy the email to vars for logging
                        #    then {
                        #        vars.certemail = cert.subject_alt.email;
                        #    }
                        #} # post_authentication

                    }

                    # EAP-TEAP authentication with PAP. See the eap-teap-windows
                    # example for chained machine and user authentication with
                    # EAP-TLS and EAP-MSCHAPv2.
                    eap_teap {
                        tls {

                            # EAP server private key
                            certificate_key "EAP_SERVER_KEY";

                            # EAP server certificate chain file
                            certificate "EAP_SERVER_CERT";

                            # For password authentication do not require client certificate
                            require_client_certificate false;

                        } # end of tls block

                        @authentication {
                            # Request EAP-TEAP user identity
                            eap_teap_identity_type user;

                            # Prompt the client for a username and password. With a
                            # challenge the client answers with a password, so inner
                            # EAP methods such as EAP-MSCHAPv2 cannot be offered here.
                            challenge "Enter user password?";

                            backend {
                                name "JSONFILE_USERS_INTERNAL";
                                query "FIND_USER";
                            }
                            pap;
                        }

                        # log inner authentication requests
                        @post_authentication {
                            invoke "LOG_AUTHENTICATION";
                        }
                    } # eap_teap
                } # eap

                # set VLAN attributes, overwriting any existing values
                radius.reply.attr.Tunnel-Type:1 = "VLAN";
                # with FreeRADIUS dictionary
                #radius.reply.attr.Tunnel-Medium-Type:1 = "IEEE-802";
                # with Radiator dictionary
                radius.reply.attr.Tunnel-Medium-Type:1 = "Ether_802";
                # assign VLAN ID 145 to RADIUS attribute
                radius.reply.attr.Tunnel-Private-Group-Id:1 = "145";
            }

            @final_execute {
                invoke "LOG_AUTHENTICATION";
            }

        } # handler

        # DEFAULT handler rejects all authentication, accepts accounting
        handler "DEFAULT-EAP" {
            conditions any {
                radius.request.code == any;
            }
            @execute {
                if all {
                    radius.request.code == radius.ACCOUNTING_REQUEST;
                } then {
                    accept;
                } else {
                    reason "DEFAULT: No other matching authentication handler found.";
                    reject;
                }
            }
            @final_execute {
                invoke "LOG_ACCOUNTING";
                invoke "LOG_AUTHENTICATION";
            }
        }
    }


    # DEFAULT policy is to reject authentication and accept accounting
    # matches if none of the previous policies match
    policy "DEFAULT" {

        # a policy without conditions will handle any request

        # DEFAULT handler rejects all authentication, accepts accounting
        handler "DEFAULT" {
            conditions any {
                radius.request.code == any;
            }
            @execute {
                if all {
                    radius.request.code == radius.ACCOUNTING_REQUEST;
                } then {
                    accept;
                } else {
                    reason "DEFAULT: No other matching authentication handler found.";
                    reject;
                }
            }
            @final_execute {
                invoke "LOG_ACCOUNTING";
                invoke "LOG_AUTHENTICATION";
            }

        } # handler "DEFAULT"
    } # policy
} # aaa
