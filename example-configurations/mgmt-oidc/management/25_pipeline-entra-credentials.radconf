# management/25_pipeline-entra-credentials.radconf
#
# Client credentials of the Entra application for Microsoft Graph lookups. Use the same
# tenant, application and secret as the "entra" oidc provider in 20_management.radconf.
#

aaa {
    @pipeline "SET_ENTRA_GRAPH_CREDENTIALS" {
        vars.entra.token_url = "https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token";
        vars.entra.client = "APPLICATION_CLIENT_ID";
        vars.entra.secret = "APPLICATION_CLIENT_SECRET";
    }
}
